[Unit]
Description=Humatron Gunicorn / Uvicorn ASGI Application
After=network.target postgresql.service redis.service

[Service]
Type=notify
User=www-data
Group=www-data
WorkingDirectory=/var/www/humatron
EnvironmentFile=/var/www/humatron/.env
ExecStart=/var/www/humatron/venv/bin/gunicorn \
          -w 4 \
          -k uvicorn.workers.UvicornWorker \
          -b 127.0.0.1:8000 \
          --access-logfile /var/log/humatron/access.log \
          --error-logfile /var/log/humatron/error.log \
          --timeout 120 \
          config.asgi:application
ExecReload=/bin/kill -s HUP $MAINPID
KillMode=mixed
TimeoutStopSec=30
PrivateTmp=true
Restart=always
RestartSec=5s

[Install]
WantedBy=multi-user.target
