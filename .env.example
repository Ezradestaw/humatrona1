# Humatron Environment Configuration Template
# Copy this file to .env and set your secrets. Never commit .env to version control.

# Django Core
DJANGO_SECRET_KEY=replace-with-a-cryptographically-secure-random-key-at-least-50-chars
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=humatron.me,www.humatron.me,localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=https://humatron.me,https://www.humatron.me

# Database (PostgreSQL)
DATABASE_URL=postgresql://humatron_user:strong_password@localhost:5432/humatron_db

# Cache & Celery (Redis)
REDIS_URL=redis://127.0.0.1:6379/0
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/0
CELERY_TASK_ALWAYS_EAGER=False

# Email (Namecheap Private Email SMTP)
SMTP_HOST=mail.privateemail.com
SMTP_PORT=587
SMTP_USE_TLS=True

SUPPORT_EMAIL=support@humatron.me
SUPPORT_EMAIL_APP_PASSWORD=your_support_app_password_here

CONTACT_EMAIL=contact@humatron.me
CONTACT_EMAIL_APP_PASSWORD=your_contact_app_password_here

ADMIN_EMAIL=admin@humatron.me
DEFAULT_FROM_EMAIL=Humatron Support <support@humatron.me>
DEFAULT_CONTACT_FROM_EMAIL=Humatron Contact <contact@humatron.me>

# PayPal API Configuration
PAYPAL_MODE=sandbox
PAYPAL_CLIENT_ID=your_paypal_client_id
PAYPAL_CLIENT_SECRET=your_paypal_client_secret

# Telebirr Configuration
TELEBIRR_RECEIVER_PHONE=0911000000
TELEBIRR_MERCHANT_NAME=Humatron
TELEBIRR_USD_TO_ETB_RATE=135.0
TELEBIRR_DEFAULT_PRICE_ETB=6750.0

# Document & Processing Limits
MAX_UPLOAD_SIZE_MB=50
MAX_PAGES=200
MAX_PROCESSING_TIME_SECONDS=180
FILE_RETENTION_DAYS=7
PDF_RENDER_DPI=150
PDF_METADATA_PRODUCER="Humatron PDF Processor"
PDF_METADATA_TITLE=""
PDF_METADATA_CREATOR=""

# OCR Stealth PDF Degradation (Stress-testing OCR defenses)
PDF_STEALTH_ENABLED=True
PDF_STEALTH_SSIM=0.985
PDF_STEALTH_STRENGTH=
PDF_STEALTH_GEO=1.0
PDF_STEALTH_TILE=256
PDF_STEALTH_SKIP=
PDF_STEALTH_ONLY=


# Production Security Headers (Set True for production HTTPS)
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
