# Humatron Environment Configuration Template
# Copy this file to .env and set your secrets. Never commit .env to version control.

# Django Core
DJANGO_SECRET_KEY=replace-with-a-cryptographically-secure-random-key-at-least-50-chars
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=humatron.me,www.humatron.me,localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=https://humatron.me,https://www.humatron.me

# Database (PostgreSQL)
DATABASE_URL=postgresql://humatron_user:strong_password@localhost:5432/humatron_db

# Cache & Celery (Redis)
REDIS_URL=redis://127.0.0.1:6379/0
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/0
CELERY_TASK_ALWAYS_EAGER=False

# Email (SMTP)
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.mailgun.org
EMAIL_PORT=587
EMAIL_HOST_USER=postmaster@humatron.me
EMAIL_HOST_PASSWORD=smtp_password
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=Humatron PDF <noreply@humatron.me>
ADMIN_EMAIL=admin@humatron.me

# PayPal API Configuration
PAYPAL_MODE=sandbox
PAYPAL_CLIENT_ID=your_paypal_client_id
PAYPAL_CLIENT_SECRET=your_paypal_client_secret

# Telebirr Configuration
TELEBIRR_RECEIVER_PHONE=0911000000
TELEBIRR_MERCHANT_NAME=Humatron
TELEBIRR_USD_TO_ETB_RATE=135.0
TELEBIRR_DEFAULT_PRICE_ETB=6750.0

# Document & Processing Limits
MAX_UPLOAD_SIZE_MB=50
MAX_PAGES=200
MAX_PROCESSING_TIME_SECONDS=180
FILE_RETENTION_DAYS=7

# Production Security Headers (Set True for production HTTPS)
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
